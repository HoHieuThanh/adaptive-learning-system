# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (adaptive-learning-system)
# Copy this file to .env before starting the services:
# cp .env.example .env
# DO NOT COMMIT SENSITIVE PASSWORDS TO VERSION CONTROL!
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_learning_db
POSTGRES_USER=adaptive_user
POSTGRES_PASSWORD=your_secure_password_here

# Backend Service Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
ML_SERVICE_URL=http://ml-service:8000

# ML Microservice Configuration (FastAPI)
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0

# Experiment Tracking Configuration (MLflow)
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://0.0.0.0:5000

# Frontend Configuration (React + Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME="AI Adaptive Learning System"
