# ==============================================================================
# TEMPLATE SECRET CHO MÔI TRƯỜNG KUBERNETES
# LƯU Ý BẢO MẬT: 
# - File này là TEMPLATE MẪU, KHÔNG CHỨA mật khẩu thật của môi trường production.
# - Tuyệt đối không commit file secret.yaml thật lên Git repository.
# - Để tạo secret nhanh bằng lệnh kubectl:
#   kubectl create secret generic adaptive-secrets \
#     --from-literal=POSTGRES_USER=adaptive_user \
#     --from-literal=POSTGRES_PASSWORD=adaptive_password_dev \
#     --from-literal=JWT_SECRET=adaptive_secret_key_change_in_production_2026
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: adaptive-secrets
  labels:
    app.kubernetes.io/part-of: adaptive-learning-system
type: Opaque
stringData:
  POSTGRES_USER: "adaptive_user"
  POSTGRES_PASSWORD: "adaptive_password_dev"
  JWT_SECRET: "adaptive_secret_key_change_in_production_2026"

